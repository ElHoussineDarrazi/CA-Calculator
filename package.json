{
  "name": "ca-calculator",
  "version": "1.0.0",
  "description": "Suivi du chiffre d'affaires en portage salarial",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && env -u ELECTRON_RUN_AS_NODE electron .\"",
    "electron:build": "vite build && env -u ELECTRON_RUN_AS_NODE electron-builder",
    "start": "env -u ELECTRON_RUN_AS_NODE electron ."
  },
  "build": {
    "appId": "com.ca-calculator.app",
    "productName": "CA Calculator",
    "mac": {
      "category": "public.app-category.finance",
      "target": "dmg"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    }
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.14",
    "wait-on": "^9.0.10"
  }
}
