rules_version = '2';

// Règles de sécurité Firestore — MODE MONO-UTILISATEUR.
//
// PRINCIPE : seul l'utilisateur dont l'UID est `allowlistedUid` peut lire et
// écrire. Toute autre personne authentifiée (ou non) est refusée, MÊME si elle
// connaît la structure de la base.
//
// ⚠️ Remplacez `allowlistedUid` par votre vrai UID Firebase :
//   Console Firebase > Authentication > Users > copier la colonne « UID ».
//   Puis republiez ces règles (console ou `npx firebase deploy --only firestore:rules`).
//
// Sans ces règles (ou avec `allow read, write: if true`), n'importe qui
// pourrait lire et modifier votre chiffre d'affaires.
service cloud.firestore {
  function isOwner(userId) {
    return request.auth != null
      && request.auth.uid == userId
      && request.auth.uid == allowlistedUid();
  }

  // ⬇️ COLLEZ VOTRE UID ICI (entre guillemets) ⬇️
  function allowlistedUid() {
    return 'REMPLACEZ_PAR_VOTRE_UID';
  }

  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Un document par client
      match /clients/{clientId} {
        allow read, write: if isOwner(userId);
      }

      // Onglet actif et autres métadonnées
      match /meta/{metaId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Tout le reste est refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}