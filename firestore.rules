rules_version = '2';

// Règles de sécurité Firestore.
//
// PRINCIPE : chaque utilisateur connecté n'accède qu'à son propre espace
// `users/{uid}`. Sans ces règles (ou avec `allow read, write: if true`),
// n'importe qui pourrait lire et modifier votre chiffre d'affaires.
//
// Déploiement :
//   Console Firebase > Firestore Database > Règles > coller > Publier
//   ou : npx firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Un document par client
      match /clients/{clientId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Onglet actif et autres métadonnées
      match /meta/{metaId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Tout le reste est refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}